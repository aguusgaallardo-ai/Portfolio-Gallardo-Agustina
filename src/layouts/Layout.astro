---
export interface Props {
  title?: string;
}
const { title = 'Aguus Gallardo · Portfolio'} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
		href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,600&family=Space+Grotesk:wght@500;600;700&display=swap"
		rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* paleta */
		--blush: #e0aeba; /* papel */
		--tulip: #d17684; /*barras / detalles */
		--rose: #b82635; /*títulos y acentos */
		--olive: #786025; /* etiquetas chicas */
		--garden: #292800; /* tinta / fondo oscuro */

		/* roles semánticos */
		--color-page: var(--blush);
		--color-ink: var(--garden);
		--color-heading: var(--rose);
		--color-accent: var(--tulip);
		--color-label: var(--olive);
		--color-stage: #1c1700; /* oliva bien oscuro, fondo detrás del libro */
	}

	*{
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background-color: var(--color-page);
		color: var(--color-ink);
		font-family: 'Space Grotesk', sans-serif;
	}

	h1, 
	h2, 
	h3 {
		font-family: "Fraunces", serif;
		margin: 0;
		line-height: 1.1;
	}

	.titulo-italic {
		font-style: italic;
		font-weight: 600;
	}

	.etiqueta {
		font-family: "Space Grotesk", sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75rem;
		color: var(--color-label);
	}

	:focus-visible {
		outline: 2px solid var(--color-heading);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		*{
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>