---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Portfolio de Agustina Gallardo - Desarrolladora de Software.' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Port fo lio</title>
	</head>
	<body>
		<slot />
	</body>
</html>