---
export interface Props {
  title?: string;
}
const { title = 'Aguus Gallardo · Portfolio'} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
		href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,700;1,600&family=Great+Vibes&family=Montserrat:wght@400;500;600; 700&display=swap"
		rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* paleta */
		--cherry: #670626;
		--blush: #e8b7c2;
		--porcelain: #f3eeec;
		--strawberry: #db8291;
		--aluminum: #d8d1cc;

		/* roles semánticos */
		--color-stage: var(--porcelain); /* fondo general del sitio, detras del libro */
		--color-book: var(--strawberry); /* color de la tapa del libro */
		--color-page: var(--aluminum); /* color de las hojas internas */
		--color-heading: var(--cherry); /* titulos (incluye "Portfolio") */
		--color-ink: var(--blush); /* texto de las paginas internas */
		--color-accent: var(--blush); /* nombre y "desarrolladora" en la tapa */
		--color-label: var(--cherry); /*etiquetas chicas: "01", "02"... */
	}

	*{
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		background-color: var(--color-page);
		color: var(--color-ink);
		font-family: 'Montserrat', sans-serif;
	}

	h1, 
	h2, 
	h3 {
		font-family: "Fraunces", serif;
		margin: 0;
		line-height: 1.1;
	}

	.titulo-italic {
		font-style: italic;
		font-weight: 600;
	}

	.etiqueta {
		font-family: "Montserrat", sans-serif;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75rem;
		color: var(--color-label);
	}

	:focus-visible {
		outline: 2px solid var(--color-heading);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		*{
			animation-duration: 0.01ms !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>