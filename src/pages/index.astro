---
import Layout from "../layouts/Layout.astro";
import StarryBackground from "../components/StarryBackground.astro";
import Starburst from "../components/Starburst.astro";
import Barcode from "../components/Barcode.astro";
import PageNav from "../components/PageNav.astro";
---

<Layout title="Tapa">
	<main class="page cover">
		<StarryBackground bg="var(--pink)" />

		<div class="cover-content page-content">
			<div class="cover-top">
				<div class="wordmark">
					<span>Port</span>
					<span class="wordmark-line">fo <em>¡Cool!</em></span>
					<span>lio</span>
				</div>
				<div class="edition-badge">
					<span>★</span>
					<span>2026</span>
				</div>
			</div>

			<p class="subtitle">💿 Código Propio</p>

			<div class="coverlines">
				<p class="coverline coverline--turq">¡OMG! TEST</p>
				<p class="coverline coverline--navy">¿Qué</p>
				<p class="coverline coverline--lime">LENGUAJE<br />de</p>
				<p class="coverline coverline--green">PROGRAMACIÓN</p>
				<p class="coverline coverline--navy">sos? 😍</p>
			</div>

			<p class="tag chip">Edición especial • Agustina Gallardo</p>
			
			<div class="cover-footer">
				<div class="burst-wrap">
					<Starburst color="var(--yelow)" rotate="-10deg">
						<p class="burst.text">¡Encontrá proyectos, herramientas y conocimiento!</p>
					</Starburst>
				</div>

				<div class="cover-headline">
					<h1 class="headline">Desarrolladora<br />de Software</h1>
					<p class="tagline">De aprender a programar a crear mi propio camino.</p>
				</div>
			</div>

			<img class="cover-illustration"
			src="/public/images/perfil/foto-brazos-cruzado.png"
			alt="Ilustración de Agustina Gallardo con los brazos cruzados"/>

			<div class="barcode-wrap">
				<Barcode />
			</div>
		</div>
	</main>

	<PageNav nextHref="/carta-editora" nextLabel="Carta de la editora" />
</Layout>

<style>
	.cover { color: var(--navy); }

	.cover-content {
		max-width: 1100px;
		padding-bottom: 2rem;
	}

	.cover-top{
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}

	.wordmark {
		font-family: var(--font-wordmark);
		font-weight: 700;
		line-height: 0.85;
		font-size: clamp(3.5rem, 9vw, 6rem);
		color: var(--navy);
	}
	.wordmark span { display: block; }
	.wordmark-line em {
		font-style: normal;
		font-family: var(--font-headline);
		font-size: 0.35em;
		background: var(--pink);
		color: #fff;
		padding: 0.1em 0.3em;
		border-radius: 0.3em;
		vertical-align: middle;
		display: inline-block;
		transform: rotate(-6deg);
	}

	.edition-badge {
		font-family: var(--font-mono);
		font-weight: 700;
		writing-mode: vertical-rl;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--violet);
		font-size: 1.5rem;
	}

	.subtitle {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 1.6rem;
		margin-top: 0.5rem;
	}

	.coverlines {
		margin-top: 1.5rem;
		max-width: 60%;
	}
	.coverline {
		font-family: var(--font-headline);
		font-weight: 400;
		line-height: 1;
		font-size: clamp(1.8rem, 4.5vw, 2.8rem);
		text-shadow: 2px 2px 0 var(--navy);
	}
	.coverline--turq { color: var(--turquoise); }
	.coverline--green { color: #7ED957; }
	.coverline--navy { color: var(--navy); text-shadow: none; -webkit-text-stroke: 1px #fff; }

	.tag {
		margin-top: 1.5rem;
		background: var(--yellow);
	}

	.cover-footer {
		margin-top: 0.5rem;
		display: flex;
		align-items: flex-end;
		gap: 1.5rem;
		max-width: 62%;
	}

	.burst-wrap { width: 180ox; flex-shrink: 0; }
	.burst-text {
		font-family: var(--font-headline);
		font-size: 0.85rem;
		line-height: 1.1;
	}

	.cover-headline .headline {
		color: #fff;
		font-size: clamp(2.2rem, 5.5vw, 3.5rem);
		text-shadow: 3px 3px 0 var(--navy);
	}
	.tagline {
		margin-top: 0.75rem;
		font-style: italic;
		color: #fff;
		font-size: 1.05rem;
		max-width: 32ch;
	}

	.cover-illustration {
		position: absolute;
		right: 2%;
		bottom: 0;
		width: min(38%, 420px);
		z-index: 3;
	}

	.barcode-wrap {
		margin-top: 2.5rem;
	}

	@media (max-width: 760px) {
		.coverlines, .cover-footer { max-width: 100%; }
		.cover-illustration { position: static; width: 70%; margin: 2rem auto 0; }
		.cover-footer { flex-direction: column; align-items: flex-start;}
	}
</style>