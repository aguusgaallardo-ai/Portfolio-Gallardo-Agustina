---
import Layout from '../layouts/Layout.astro';

const questions = [
  { q: 'Son las 2 AM y tenés un bug que no cede. ¿Qué hacés?', options: [
    { letter: 'A', text: 'Lo dejo reposar, mañana lo veo con la cabeza fresca' },
    { letter: 'B', text: 'Abro 15 pestañas de Stack Overflow y pruebo todo' },
    { letter: 'C', text: 'Reviso la documentación línea por línea' },
    { letter: 'D', text: 'No me voy a dormir hasta resolverlo' },
    { letter: 'E', text: 'Le doy una vuelta creativa, algo que nadie esperaba' },
    { letter: 'F', text: 'Simplifico todo y voy directo al problema' },
  ]},
  { q: 'Te asignan un proyecto nuevo del que no sabés nada. ¿Primer movimiento?', options: [
    { letter: 'A', text: 'Empiezo a probar cositas sueltas' },
    { letter: 'B', text: 'Investigo mil herramientas antes de arrancar' },
    { letter: 'C', text: 'Armo un plan estructurado' },
    { letter: 'D', text: 'Leo toda la documentación técnica' },
    { letter: 'E', text: 'Empiezo por la parte que más me copa' },
    { letter: 'F', text: 'Voy directo a lo esencial' },
  ]},
  { q: 'Te llega una devolución dura en un code review. ¿Cómo reaccionás?', options: [
    { letter: 'A', text: 'Lo tomo con calma, lo charlo y ajusto' },
    { letter: 'B', text: 'Nerviosa, pero lo arreglo en tiempo récord' },
    { letter: 'C', text: 'Reviso cada comentario como checklist' },
    { letter: 'D', text: 'Me lo tomo personal y reviso todo' },
    { letter: 'E', text: 'Le doy mi propio enfoque, distinto' },
    { letter: 'F', text: 'Aplico los cambios rápido y sigo' },
  ]},
  { q: 'Se acerca la entrega y falta bastante. ¿Qué actitud tomás?', options: [
    { letter: 'A', text: 'Organizo prioridades y voy tranqui' },
    { letter: 'B', text: 'Modo multitarea total' },
    { letter: 'C', text: 'Cronograma estricto, al pie de la letra' },
    { letter: 'D', text: 'Me obsesiono con que salga perfecto' },
    { letter: 'E', text: 'Busco la forma más creativa de llegar' },
    { letter: 'F', text: 'Voy a lo mínimo indispensable' },
  ]},
  { q: 'Elegís tu ambiente ideal para programar.', options: [
    { letter: 'A', text: 'Algo relajado de fondo' },
    { letter: 'B', text: 'Playlist random según el humor' },
    { letter: 'C', text: 'Silencio total, necesito orden' },
    { letter: 'D', text: 'Algo intenso, tensión y foco' },
    { letter: 'E', text: 'Algo distinto, fuera de lo común' },
    { letter: 'F', text: 'Lo que sea, no le doy vueltas' },
  ]},
  { q: 'Un compañero te pide ayuda con su código.', options: [
    { letter: 'A', text: 'Explico con calma y ejemplos simples' },
    { letter: 'B', text: 'Tiro mil ideas a la vez' },
    { letter: 'C', text: 'Armo un paso a paso ordenado' },
    { letter: 'D', text: 'Reviso todo con lupa' },
    { letter: 'E', text: 'Propongo una solución distinta' },
    { letter: 'F', text: 'Doy la solución más directa' },
  ]},
];
---
<Layout title="Test" pageBg="var(--paper)" index={8} total={11} prevHref="/herramientas" nextHref="/contacto">
  <div class="page-content quiz-page">
    <p class="eyebrow">¡OMG! Test</p>
    <h1 class="headline quiz-title">¿Qué lenguaje sos?</h1>

    <form id="quiz-form" class="quiz">
      {questions.map((item, i) => (
        <fieldset class="question" data-step={i + 1} hidden={i !== 0}>
          <p class="question-progress">Pregunta {i + 1} / {questions.length}</p>
          <legend>{item.q}</legend>
          <div class="options">
            {item.options.map((opt) => (
              <label class="option">
                <input type="radio" name={`q${i + 1}`} value={opt.letter} />
                <span class="option-letter">{opt.letter}</span>
                <span>{opt.text}</span>
              </label>
            ))}
          </div>
          <div class="step-actions">
            {i > 0 && <button type="button" class="btn btn--ghost" data-action="prev">‹ Anterior</button>}
            <span class="spacer"></span>
            {i < questions.length - 1
              ? <button type="button" class="btn" data-action="next">Siguiente ›</button>
              : <button type="submit" class="btn">Ver mi resultado</button>}
          </div>
        </fieldset>
      ))}
    </form>

    <div id="quiz-result" class="quiz-result" hidden></div>
  </div>
</Layout>

<script>
  const letterMap: Record<string, string> = { A: 'Python', B: 'JavaScript', C: 'Java', D: 'C++', E: 'Ruby', F: 'Go' };

  const results: Record<string, { emoji: string; desc: string }> = {
    Python: { emoji: '🐍', desc: 'Sos calma en estado puro. Simple, versátil, sin hacer ruido.' },
    JavaScript: { emoji: '⚡', desc: 'Sos caos organizado. Estás en todos lados, pero siempre funciona.' },
    Java: { emoji: '☕', desc: 'Sos estructura y disciplina. Con el plan armado, no hay quien te pare.' },
    'C++': { emoji: '⚙️', desc: 'Sos perfeccionismo absoluto. Sin atajos, hasta que esté exacto.' },
    Ruby: { emoji: '💎', desc: 'Sos creatividad pura. Tu propio camino, y te sale bien.' },
    Go: { emoji: '🎯', desc: 'Sos practicidad sin vueltas. Directo a lo que funciona.' },
  };

  const form = document.getElementById('quiz-form') as HTMLFormElement | null;
  const resultEl = document.getElementById('quiz-result');
  const steps = Array.from(document.querySelectorAll<HTMLFieldSetElement>('.question'));

  function showStep(n: number) {
    steps.forEach((step) => { step.hidden = Number(step.dataset.step) !== n; });
  }

  form?.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!target) return;
    const action = target.dataset.action;
    const currentStep = steps.find((s) => !s.hidden);
    if (!currentStep) return;
    const current = Number(currentStep.dataset.step);

    if (action === 'next') {
      if (!currentStep.querySelector('input:checked')) return;
      showStep(current + 1);
    } else if (action === 'prev') {
      showStep(current - 1);
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form) return;
    const data = new FormData(form);
    const tally: Record<string, number> = {};

    for (let i = 1; i <= steps.length; i++) {
      const letter = data.get(`q${i}`);
      if (!letter || typeof letter !== 'string') return;
      const lang = letterMap[letter];
      tally[lang] = (tally[lang] || 0) + 1;
    }

    const max = Math.max(...Object.values(tally));
    const winners = Object.keys(tally).filter((lang) => tally[lang] === max);

    form.hidden = true;
    if (resultEl) {
      resultEl.hidden = false;
      resultEl.innerHTML = winners
        .map((lang) => {
          const r = results[lang];
          return `<div class="result-card"><span class="result-emoji">${r.emoji}</span><h3>${lang}</h3><p>${r.desc}</p></div>`;
        })
        .join('');
    }
  });
</script>

<style>
  .quiz-page { gap: 2%; }
  .quiz-title { color: var(--pink); font-size: 6.5cqw; margin: 1% 0 3%; text-shadow: 2px 2px 0 var(--navy); }

  .quiz { flex: 1; display: flex; flex-direction: column; }
  .question { border: none; padding: 0; margin: 0; display: flex; flex-direction: column; flex: 1; }
  .question-progress { font-family: var(--font-mono); font-size: 0.68rem; color: var(--violet); margin-bottom: 0.3rem; }
  .question legend {
    padding: 0;
    font-family: var(--font-tag);
    font-size: 1.05rem;
    color: var(--navy);
    margin-bottom: 3%;
  }
  .options { display: flex; flex-direction: column; gap: 2%; flex: 1; }
  .option {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border: 2px solid var(--navy);
    border-radius: 10px;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-size: 0.78rem;
  }
  .option:has(input:checked) { background: var(--yellow); }
  .option-letter { font-family: var(--font-mono); font-weight: 700; color: var(--pink); flex-shrink: 0; }

  .step-actions { display: flex; align-items: center; margin-top: 4%; }
  .spacer { flex: 1; }

  .quiz-result { display: flex; flex-direction: column; justify-content: center; flex: 1; gap: 1rem; }
  .result-card { background: var(--navy); color: var(--paper); border-radius: 14px; padding: 8%; text-align: center; }
  .result-emoji { font-size: 2.5rem; }
  .result-card h3 { font-family: var(--font-headline); color: var(--yellow); font-size: 1.6rem; margin: 0.4rem 0; }
  .result-card p { font-size: 0.85rem; }
</style>