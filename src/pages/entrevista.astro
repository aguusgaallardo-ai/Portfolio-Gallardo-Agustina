---
import Layout from '../layouts/Layout.astro';

const qa = [
  {
    q: '¿Cómo te describirías?',
    a: 'Persistente, determinada e inquieta. Una mezcla de curiosidad, sensibilidad y creatividad, con una cabeza que no para hasta encontrarle la vuelta a todo.',
  },
  {
    q: '¿Cómo es tu día a día?',
    a: 'Distribuyo bien mi tiempo para hacer todo sin volverme loca en el camino: por la mañana trabajo en atención al público —ahí aprendí muchísimo a manejar la paciencia y la confianza en mí misma— y por la tarde-noche curso.',
  },
  {
    q: '¿Cómo arrancaste con la programación?',
    a: 'Hice un curso de Testing QA en 2022 (del cual me recibí, así que técnicamente soy tester QA) y ahí fue donde se despertó la curiosidad: quería entender cómo funcionaban las páginas por dentro. Eso, y el plan de estudios de la Tecnicatura, terminó de convencerme.',
  },
];
---
<Layout title="Entrevista" pageBg="var(--paper)" index={4} total={11} prevHref="/perfil" nextHref="/entrevista-2">
  <div class="page-content interview">
    <p class="eyebrow">Entrevista</p>
    <p class="kicker">"Una persona que siente mucho, pregunta aún más y se rinde poco."</p>

    <div class="qa-list">
      {qa.map((item) => (
        <div class="qa-item">
          <h3 class="qa-question">{item.q}</h3>
          <p class="qa-answer">{item.a}</p>
        </div>
      ))}
    </div>
  </div>
</Layout>

<style>
  .interview { gap: 4%; }
  .kicker {
    font-style: italic;
    font-size: 1.05rem;
    color: var(--violet);
    margin: 4% 0 6%;
  }
  .qa-list { display: flex; flex-direction: column; gap: 5%; }
  .qa-question {
    font-family: var(--font-tag);
    color: var(--pink);
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .qa-answer { font-size: 0.9rem; line-height: 1.45; }
</style>