---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Perfil" pageBg="var(--paper)" index={3} total={11} prevHref="/carta-editora" nextHref="/entrevista">
  <div class="page-content profile-opener">
    <svg class="doodle doodle--star" viewBox="0 0 200 80" aria-hidden="true">
      <path d="M10 60 L20 20 L30 60 L20 45 Z" fill="var(--pink)" />
      <path d="M35 30 C 80 5, 130 5, 180 20" stroke="var(--pink)" stroke-width="3" fill="none" stroke-linecap="round" />
    </svg>

    <h1 class="headline profile-title">¡Holaaa!<br />Me presento soy Agus</h1>

    <div class="polaroid-wrap">
      <div class="polaroid">
        <img src="/public/images/perfil/foto-presentacion.png" alt="Foto de Agustina Gallardo" />
        <p class="polaroid-caption headline">Desarrolladora<br />de Software</p>
      </div>

      <img
        class="pointing-illustration"
        src="/public/images/perfil/ilustracion-senalando.png"
        alt="Ilustración de Agustina señalando hacia arriba"
      />
    </div>
  </div>
</Layout>

<style>
  .profile-opener { position: relative; }

  .doodle { width: 26%; position: absolute; top: 2%; right: 4%; }

  .profile-title {
    color: var(--navy);
    font-size: 7cqw;
    margin: 4% 0 6%;
  }

  .polaroid-wrap {
    position: relative;
    width: 68%;
    margin: 0 auto;
    flex: 1;
  }
  .polaroid {
    background: #fdfcf8;
    border: 2px solid var(--navy);
    padding: 5% 5% 8%;
    transform: rotate(-2deg);
    box-shadow: 5px 5px 0 var(--navy);
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--navy);
  }
  .polaroid-caption {
    text-align: center;
    margin-top: 6%;
    color: var(--navy);
    font-size: 4.5cqw;
    line-height: 1.1;
  }
  .pointing-illustration {
    position: absolute;
    right: -14%;
    bottom: -6%;
    width: 42%;
    z-index: 2;
  }
</style>