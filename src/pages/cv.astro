---
import Layout from '../layouts/Layout.astro';
---
<Layout title="CV" pageBg="var(--navy)" pageColor="var(--paper)" index={10} total={11} prevHref="/contacto" nextHref="/contratapa">
  <div class="page-content cv-content">
    <p class="eyebrow eyebrow--light">Póster central</p>

    <img class="cv-photo" src="/public/images/perfil/foto-presentacion.png" alt="Foto de Agustina Gallardo" />

    <div class="cv-text">
      <h1 class="headline">Agustina<br />Gallardo</h1>
      <p class="cv-tagline">¿Querés saber más? Llevate el papel completo.</p>
      <a class="btn" href="/cv/AgustinaGallardo-CV.pdf" download="AgustinaGallardo-CV.pdf">Descargá mi CV</a>
    </div>
  </div>
</Layout>

<style>
  .cv-content { color: var(--paper); align-items: center; text-align: center; justify-content: center; gap: 4%; }
  .eyebrow--light { color: var(--turquoise); align-self: flex-start; }
  .cv-photo { width: 55%; border-radius: 16px; border: 3px solid var(--yellow); }
  .cv-text .headline { color: var(--yellow); font-size: 8cqw; }
  .cv-tagline { margin: 4% 0; font-size: 0.9rem; max-width: 26ch; }
</style>