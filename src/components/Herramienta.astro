---
interface Props {
    nombre: string;
}

const { nombre } = Astro.props;
---
<li class="herramienta">{nombre}</li>

<style>
    .herramienta {
        list-style: none;
        background: color-mix(in srgb, var(--color-page) 85%, white);
        border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent);
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        font-weight: 600;
        color: var(--color-ink);
    }
</style>