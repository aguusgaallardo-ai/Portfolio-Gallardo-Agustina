---
interface Props {
    color?: string;
    rotate?: string;
}
const { color = 'var(--yellow)', rotate = '-8deg' } = Astro.props;
---

<div class="burst" style={`--burst-color:${color}; --burst-rotate:${rotate};`}>
    <div class="burst-inner">
        <slot />
    </div>
</div>

<style>
    .burst {
        position: relative;
        width: 100%;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .burst::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--burst-color);
        clip-path: polygon(
            50% 0%, 61% 18%, 80% 8%, 82% 29%, 100% 33%, 90% 50%,
      100% 67%, 82% 71%, 80% 92%, 61% 82%, 50% 100%, 39% 82%,
      20% 92%, 18% 71%, 0% 67%, 10% 50%, 0% 33%, 18% 29%,
      20% 8%, 39% 18%
        );
        transform: rotate(var(--burst-color));
    }

    .burst-inner {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 14%;
    }
</style>