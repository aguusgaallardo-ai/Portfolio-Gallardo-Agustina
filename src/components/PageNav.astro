---
interface Props {
  label: string;
  prevHref?: string;
  nextHref?: string;
}
const { label, prevHref, nextHref } = Astro.props;
---
<nav class="page-nav" aria-label="Navegación de la revista">
  {prevHref
    ? <a class="page-nav__btn" href={prevHref}>‹ Anterior</a>
    : <span class="page-nav__btn page-nav__btn--disabled">‹ Anterior</span>}

  <span class="page-nav__count">Pág. {label}</span>

  {nextHref
    ? <a class="page-nav__btn" href={nextHref}>Siguiente ›</a>
    : <span class="page-nav__btn page-nav__btn--disabled">Siguiente ›</span>}
</nav>

<style>
  .page-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--navy);
    color: var(--paper);
    border-radius: 999px;
    padding: 0.55rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    flex-shrink: 0;
  }
  .page-nav__btn { text-decoration: none; color: var(--paper); font-weight: 700; white-space: nowrap; }
  .page-nav__btn--disabled { opacity: 0.3; pointer-events: none; }
  .page-nav__count { opacity: 0.7; }
</style>